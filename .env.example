# Database Configuration (Neon.tech PostgreSQL)
# Main connection URL with connection pooling (recommended for most uses)
DATABASE_URL=postgres://user:password@your-db-host.neon.tech/dbname?sslmode=require

# Basic PostgreSQL Connection Parameters
PGHOST=your-db-host.neon.tech
PGUSER=your_database_user
PGDATABASE=your_database_name
PGPASSWORD=your_database_password

# Authentication (Clerk)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key
CLERK_SECRET_KEY=sk_test_your-secret-key

# Calendly Integration
# Secret used to verify webhook signatures from Calendly
CALENDLY_WEBHOOK_SECRET=your_calendly_webhook_signing_secret

# Note: Replace all placeholder values with your actual credentials
# Make sure to never commit the actual .env file to version control